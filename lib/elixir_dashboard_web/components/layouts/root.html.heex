<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix={" · #{app_name()}"}>
      <%= assigns[:page_title] || "Performance Monitor" %>
    </.live_title>
    <link rel="stylesheet" href="/assets/css/picasso_wright.css" />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/app.js"}
    >
    </script>
  </head>
  <body>
    <nav class="picasso-nav">
      <div class="picasso-nav-container">
        <div class="picasso-nav-content">
          <div class="picasso-nav-left">
            <a href="/" class="picasso-nav-brand">
              <%= app_name() %>
            </a>
            <div class="picasso-nav-links">
              <a href="/dev/performance/endpoints" class="picasso-nav-link">
                Endpoints
              </a>
              <a href="/dev/performance/queries" class="picasso-nav-link">
                Queries
              </a>
              <a href="/dev/performance/errors" class="picasso-nav-link">
                Errors
              </a>
              <a href="/dev/performance/metrics" class="picasso-nav-link">
                Metrics
              </a>
              <a href="/dev/performance/events" class="picasso-nav-link">
                Events
              </a>
              <a href="/dev/dashboard" class="picasso-nav-link">
                LiveDashboard
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>
    <%= @inner_content %>
  </body>
</html>
